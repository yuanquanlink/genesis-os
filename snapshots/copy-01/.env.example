# Unified AI router. Without the selected provider key Genesis runs in clearly
# labelled Demo AI mode. Keep every key server-side and out of Git.
MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# Legacy compatibility value requested by the initial integration. DeepSeek's
# current production model names can be selected here without changing business code.
DEFAULT_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

# Optional real-time web research provider. Keep the key server-side.
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
RESEARCH_REQUEST_TIMEOUT_MS=30000
RESEARCH_MAX_RETRIES=1
RESEARCH_POLL_INTERVAL_MS=1000
RESEARCH_MAX_POLLS=90
TAVILY_RESEARCH_MODEL=mini

# Project Challenge is local-development only until a container sandbox is configured.
GENESIS_CHALLENGE_STORAGE_PATH=./data/challenges
GENESIS_PROJECT_IMPORT_ROOTS=./data/project-imports
# Optional explicit interpreter; default is ./.runner/python after npm run bootstrap.
GENESIS_RUNNER_PYTHON=
# Optional server-side outbound proxy (useful on restricted local networks).
AI_HTTPS_PROXY=

# Optional OpenAI provider adapter. Select it with MODEL_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-5.6-luna
OPENAI_MODEL_DEEP=gpt-5.6-terra
OPENAI_REQUEST_TIMEOUT_MS=30000
# Optional stable end-user identifier. The server hashes it before sending it
# as the Responses API safety_identifier; use a random opaque value, not PII.
OPENAI_SAFETY_IDENTIFIER=local-genesis-user

# Required for browser writes in production. Comma-separated exact origins;
# wildcards are ignored. Development automatically permits localhost and
# 127.0.0.1 on the current port plus an exact local preview-proxy origin.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Modes: local_development, local_single_user, private_cloud, public.
# Only local modes are currently permitted. private_cloud/public fail production:check
# until the runtime has verified Auth, production persistence, recovery and monitoring.
GENESIS_DEPLOYMENT_MODE=local_single_user

# Local zero-config persistence. DATABASE_URL is reserved for the documented
# Supabase/PostgreSQL production adapter migration.
GENESIS_DB_PATH=./data/genesis.db
GENESIS_UPLOAD_PATH=./uploads/learning
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=learning-resources

# Optional protection for scheduled daily generation endpoint.
CRON_SECRET=
